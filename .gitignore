# Compiled Binaries (we keep precompiled binaries inside build/ for out-of-the-box WebSerial flashing)
# but we ignore giant temporary debug/log artifacts
*.elf
*.map
*.o
*.d
*.options.json
*.bak

# Local Python Caches
__pycache__/
*.pyc

# Local build and partition caches
build/cache/
data.bin

# Arduino CLI intermediate compile tree
build/esp32.esp32.esp32s3/sketch/
build/esp32.esp32.esp32s3/core/
build/esp32.esp32.esp32s3/libraries/
build/esp32.esp32.esp32s3/*.cache
build/esp32.esp32.esp32s3/compile_commands.json
build/esp32.esp32.esp32s3/file_opts
build/esp32.esp32.esp32s3/build_opt.h

# Android build caches & IDE files
.gradle/
android-app/.gradle/
android-app/.idea/
android-app/**/build/
android-app/build/
android-app/local.properties
*.iml
.idea/

# User configuration credentials (DO NOT PUBLISH)
data/config.json

# Developer references, simulations, and sandboxes (DO NOT PUBLISH)
other/
extras/
.agents/

# OS Files
.DS_Store
Thumbs.db
Desktop.ini
